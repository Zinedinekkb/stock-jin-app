# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่าจริง (ห้าม commit .env.local)
# ตัวแปรที่ระบบตั้งเอง (NODE_ENV, NEXT_RUNTIME, CI) ไม่ต้องใส่ในไฟล์นี้

# ============================================================
# จำเป็น: Firebase (ฝั่งเว็บ) ดูได้จาก Project settings > Your apps > Web app
# ============================================================
# API key ของเว็บแอป Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
# โดเมนสำหรับล็อกอิน เช่น <project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# รหัสโปรเจกต์ Firebase
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# ที่เก็บไฟล์ เช่น <project-id>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Messaging sender ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# App ID ของเว็บแอป
NEXT_PUBLIC_FIREBASE_APP_ID=
# Measurement ID ของ Analytics (ไม่บังคับ เว้นว่างได้)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# URL ของแอปที่ deploy แล้ว เช่น https://your-shop.vercel.app (ถ้าไม่ตั้งจะใช้โดเมนของคำขอ)
NEXT_PUBLIC_APP_URL=

# ============================================================
# จำเป็นสำหรับ Push แจ้งเตือน / รายงานอัตโนมัติ (ตั้งที่ Vercel)
# ============================================================
# Web Push key pair จาก Firebase > Project settings > Cloud Messaging
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Service account JSON (ดิบหรือ base64) ห้าม commit เด็ดขาด
FIREBASE_SERVICE_ACCOUNT=
# รหัสสุ่มยาวๆ ป้องกัน cron endpoint (เช่น openssl rand -hex 32)
CRON_SECRET=
# อีเมลแอดมิน (คั่นด้วยจุลภาค) ใช้เป็นผู้รับรายงานเมื่อไม่ตั้ง REPORT_EMAILS
ADMIN_EMAILS=
# อีเมลแอดมินคนเดียว (ทางเลือกแทน ADMIN_EMAILS)
ADMIN_EMAIL=

# ============================================================
# ไม่บังคับ: LINE (ถ้าไม่ตั้ง ระบบจะข้ามการส่ง LINE)
# ============================================================
# Channel access token ของ LINE Messaging API
LINE_ACCESS_TOKEN=
# ชื่ออื่นของ token ด้านบน (ใช้อย่างใดอย่างหนึ่ง และใช้กับ scripts/setup-rich-menu.mjs)
LINE_CHANNEL_ACCESS_TOKEN=
# Channel secret ใช้ตรวจลายเซ็น webhook
LINE_CHANNEL_SECRET=
# ID กลุ่ม LINE ที่รับสรุปครึ่งเดือน
LINE_GROUP_ID=
# ID ผู้ใช้ LINE (ใช้เมื่อไม่มี LINE_GROUP_ID)
LINE_USER_ID=
# ชื่อร้านบน Rich Menu (ใช้กับ scripts/setup-rich-menu.mjs ค่าเริ่มต้น StockPro)
APP_NAME=

# ============================================================
# ไม่บังคับ: อีเมล (ถ้าไม่ตั้ง ระบบจะข้ามการส่งอีเมล)
# ============================================================
# อีเมล Gmail ที่ใช้ส่ง
EMAIL_USER=
# Gmail App Password (ไม่ใช่รหัสผ่านปกติ)
EMAIL_PASS=
# SMTP host (ค่าเริ่มต้น smtp.gmail.com)
EMAIL_HOST=
# SMTP port (ค่าเริ่มต้น 465)
EMAIL_PORT=
# ชื่ออื่นของ EMAIL_USER สำหรับ SMTP อื่น
SMTP_USER=
# ชื่ออื่นของ EMAIL_PASS
SMTP_PASS=
# ชื่ออื่นของ EMAIL_HOST
SMTP_HOST=
# ชื่ออื่นของ EMAIL_PORT
SMTP_PORT=
# อีเมลผู้รับรายงานประจำวัน คั่นด้วยจุลภาค
REPORT_EMAILS=

# ============================================================
# ไม่บังคับ: Sentry (ถ้าไม่ตั้ง SENTRY_ORG/SENTRY_PROJECT จะไม่อัปโหลด source map)
# ============================================================
# DSN สำหรับเบราว์เซอร์
NEXT_PUBLIC_SENTRY_DSN=
# DSN สำหรับเซิร์ฟเวอร์
SENTRY_DSN=
# ชื่อ organization บน Sentry (ใช้ตอน build)
SENTRY_ORG=
# ชื่อ project บน Sentry (ใช้ตอน build)
SENTRY_PROJECT=
# Auth token สำหรับอัปโหลด source map ตอน build
SENTRY_AUTH_TOKEN=

# ============================================================
# ไม่บังคับ: โหมดทดลอง (Demo) สำหรับ deploy ให้คนทั่วไปลองใช้
# ตั้งเป็น true ตอน build แล้วแอปจะไม่ใช้ Firebase เลย ข้อมูลอยู่ในหน่วยความจำและรีเซ็ตเมื่อรีเฟรช
# ห้ามตั้งในโปรเจกต์จริง (ใช้ npm run build:demo หรือโปรเจกต์ Vercel แยกต่างหาก)
# ============================================================
NEXT_PUBLIC_DEMO_MODE=
